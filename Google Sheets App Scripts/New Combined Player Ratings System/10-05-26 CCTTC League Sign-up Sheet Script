function refreshDisplayTab() {
  // 1. Give the form engine time to safely commit the data row
  Utilities.sleep(2000);
  SpreadsheetApp.flush();
  
  // 2. Calculate the TARGET sheet name EXACTLY ONCE up front
  var ss = SpreadsheetApp.openById(RESPONSE_SPREADSHEET_ID);
  var displayName = formatDateForSheet(getNextSaturday(new Date()));
  
  // 3. Run your creation setup
  createDisplayTab();
  
  // 4. Run population
  var playerCount = populateDisplayTab();
  
  // 5. Target the explicit display tab directly without re-calculating the date string
  var display = ss.getSheetByName(displayName);
  
  // 6. Format only if the target sheet is verified and has players
  if (display && playerCount > 0) {
    formatDisplayRows(display, playerCount);
  }
}

function formatDisplayRows(display, playerCount) {
  try {
    if (!playerCount || playerCount < 1) return;
    var lastRow = 5 + playerCount;
    var black = '#000000';
    var thin = SpreadsheetApp.BorderStyle.SOLID_THIN;
    var thick = SpreadsheetApp.BorderStyle.SOLID_THICK;

    for (var r = 6; r <= lastRow; r++) {
      var alt = ((r - 6) % 2 === 0) ? '#ffffff' : '#d9d9d9';
      
      display.getRange(r, 4, 1, 2).setFontFamily('Roboto').setFontSize(11).setFontWeight('bold').setFontColor(black);
      
      var numCell = display.getRange(r, 4);
      numCell.setBackground(alt);
      numCell.setBorder(true, null, null, null, false, false, black, thin);
      numCell.setHorizontalAlignment('center').setVerticalAlignment('middle');
      
      var nameCell = display.getRange(r, 5);
      nameCell.setBackground(alt);
      nameCell.setBorder(true, true, null, true, false, false, black, thin);
      nameCell.setBorder(null, null, null, true, false, false, black, thick);
      nameCell.setHorizontalAlignment('left').setVerticalAlignment('middle');

      display.setRowHeight(r, 30);
    } 
    
    display.getRange(5, 4, 1, 2).setBorder(null, null, true, null, false, false, black, thick);
  } catch (error) {
    sendErrorEmail('Error in formatDisplayRows: ' + error.toString() + '\n\nStack trace: ' + error.stack);
  }
}

/**
 * Global Utility Error Function: Accessible by all spreadsheet tracking buttons
 */
function sendErrorEmail(errorMessage) {
  try {
    GmailApp.sendEmail(
      RECIPIENT_EMAIL,
      'ERROR: Saturday Table Tennis System Crash Alert',
      errorMessage,
      { name: 'CCTTC Ratings System - ERROR' }
    );
    Logger.log('Error email sent globally: ' + errorMessage);
  } catch (e) {
    Logger.log('Failed to send error email: ' + e.toString());
    Logger.log('Original error: ' + errorMessage);
  }
}
