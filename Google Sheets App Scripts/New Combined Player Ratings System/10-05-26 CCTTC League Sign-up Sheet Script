  function formatDateForSheet(date) {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return `${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
  }

  function getNextSaturday(date) {
    var skipDays = (6 - date.getDay() + 7) % 7;
    var nextSat = new Date(date.getTime());
    nextSat.setDate(date.getDate() + skipDays);
    return nextSat;
  }

function createDisplayTab() {
  try {
    var ss = SpreadsheetApp.openById(RESPONSE_SPREADSHEET_ID);
    var template = ss.getSheetByName('Template');
    if (!template) {
      throw new Error('Template tab not found in sign-up spreadsheet');
    }

    // Get the upcoming Saturday and calculate the previous Saturday (7 days prior)
    var nextSat = getNextSaturday(new Date());
    var prevSat = new Date(nextSat.getTime() - 7 * 24 * 60 * 60 * 1000); // minus 7 days
    
    var displayName = formatDateForSheet(nextSat);
    var prevDisplayName = formatDateForSheet(prevSat);
    var prevRawName = 'Raw ' + prevDisplayName;

    // Check if the display tab already exists. If it does, stop early.
    if (ss.getSheetByName(displayName)) {
      Logger.log('Display tab "' + displayName + '" already exists - skipping.');
      return;
    }

    // 1. CREATE THE NEW TAB FIRST
    // This ensures there is always an extra visible sheet, preventing the crash.
    var copy = template.copyTo(ss);
    copy.setName(displayName).showSheet();
    ss.setActiveSheet(copy);
    ss.moveActiveSheet(0);
    Logger.log('Created display tab "' + displayName + '" from Template.');

    // 2. CLEAN UP OLD DISPLAY TAB
    var prevDisplaySheet = ss.getSheetByName(prevDisplayName);
    if (prevDisplaySheet) {
      ss.deleteSheet(prevDisplaySheet);
      Logger.log('Deleted previous week display tab: ' + prevDisplayName);
    }

    // 3. SMART CLEANUP: Only delete the old Raw tab if the new week's Raw tab is ready.
    // This protects your active form destination link if scripts run out of order on Sundays.
    var currentRawSheetName = 'Raw ' + displayName;
    var currentRawSheetExists = ss.getSheetByName(currentRawSheetName);
    
    if (currentRawSheetExists) {
      var prevRawSheet = ss.getSheetByName(prevRawName);
      if (prevRawSheet) {
        ss.deleteSheet(prevRawSheet);
        Logger.log('Deleted previous week raw tab: ' + prevRawName);
      }
    } else {
      Logger.log('New Raw tab "' + currentRawSheetName + '" not found yet. Postponing old Raw tab deletion to preserve form connection.');
    }

  } catch (error) {
    sendErrorEmail('Error in createDisplayTab: ' + error.toString() + '\n\nStack trace: ' + error.stack);
  }
}

function populateDisplayTab() {
  try {
    var ss = SpreadsheetApp.openById(RESPONSE_SPREADSHEET_ID);
    var displayName = formatDateForSheet(getNextSaturday(new Date()));
    var rawSheet = ss.getSheetByName('Raw ' + displayName);
    var display = ss.getSheetByName(displayName);

    if (!rawSheet) {
      throw new Error('Raw tab "Raw ' + displayName + '" not found.');
    }
    if (!display) {
      throw new Error('Display tab "' + displayName + '" not found - run createDisplayTab() first.');
    }

    var rawLastRow = rawSheet.getLastRow();
    if (rawLastRow < 2) {
      Logger.log('No responses in "Raw ' + displayName + '" yet.');
      return 0;
    }
    
    var rawLastCol = rawSheet.getLastColumn();
    var headers = rawSheet.getRange(1, 1, 1, rawLastCol).getValues()[0];
    var nameIdx = -1;
    var playingIdx = -1;
    var emailIdx = -1;
    
    for (var c = 0; c < headers.length; c++) {
      var h = String(headers[c] || '').toLowerCase().trim();
      if (h.indexOf('name') !== -1) { 
        nameIdx = c; 
      } else if (h.indexOf('playing') !== -1 || h.indexOf('status') !== -1 || h.indexOf('are you') !== -1) {
        playingIdx = c;
      } else if (h.indexOf('email') !== -1) {
        emailIdx = c;
      }
    }
    
    if (nameIdx === -1) { nameIdx = 1; }
    if (playingIdx === -1) { playingIdx = 3; }
    if (emailIdx === -1) { emailIdx = 2; }

    var dataRows = rawSheet.getRange(2, 1, rawLastRow - 1, rawLastCol).getValues();
    var players = [];
    var trackedEmails = {};
    var trackedNames = {};
    
    for (var r = dataRows.length - 1; r >= 0; r--) {
      var row = dataRows[r];
      var name = String(row[nameIdx] || '').trim();
      var nameKey = name.toLowerCase();
      var emailKey = String(row[emailIdx] || '').trim().toLowerCase();
      var playingStatus = String(row[playingIdx] || '').trim().toLowerCase();
      
      if (!name || name === '') continue;
      
      var alreadyTracked = false;
      if (emailKey && (emailKey in trackedEmails)) alreadyTracked = true;
      if (nameKey in trackedNames) alreadyTracked = true;
      
      if (!alreadyTracked) {
        if (emailKey) trackedEmails[emailKey] = playingStatus;
        trackedNames[nameKey] = playingStatus;
        
        if (playingStatus === 'yes') {
          var paddedName = "\u00A0\u00A0\u00A0" + name;
          players.unshift([paddedName]);
        }
      }
    }

    var organizedPlayers = [];
    for (var p = 0; p < players.length; p++) {
      var rowNumberStr = (p + 1) + ".";
      organizedPlayers.push([rowNumberStr, players[p]]);
    }

    if (organizedPlayers.length === 0) {
      var footerRowEmpty = findFooterRow(display, 6);
      if (footerRowEmpty && footerRowEmpty > 6) {
        display.getRange(6, 4, footerRowEmpty - 6, 2).clearContent();
        display.deleteRows(6, footerRowEmpty - 6);
      }
      Logger.log('No valid players to populate.');
      return 0;
    }

    var footerRow = findFooterRow(display, 6);
    if (!footerRow) {
      throw new Error('Footer row not found on display tab "' + displayName + '".');
    }

    if (footerRow > 6) {
      display.getRange(6, 4, footerRow - 6, 2).clearContent();
      display.deleteRows(6, footerRow - 6);
    }
    
    display.insertRows(6, organizedPlayers.length);
    display.getRange(6, 4, organizedPlayers.length, 2).clearContent();
    display.getRange(6, 4, organizedPlayers.length, 2).setValues(organizedPlayers);
    
    Logger.log('Populated "' + displayName + '" with ' + organizedPlayers.length + ' players.');
    return organizedPlayers.length;
  } catch (error) {
    sendErrorEmail('Error in populateDisplayTab: ' + error.toString() + '\n\nStack trace: ' + error.stack);
    return 0;
  }
}

function findFooterRow(sheet, fromRow) {
  var lastRow = sheet.getLastRow();
  for (var r = fromRow; r <= lastRow; r++) {
    var vals = sheet.getRange(r, 1, 1, sheet.getLastColumn()).getValues()[0];
    for (var c = 0; c < vals.length; c++) {
      var v = String(vals[c] || '').toLowerCase();
      // UPDATED LOOKUP STRING: Matches your newly configured hyperlink cell text natively
      if (v.indexOf('league results') !== -1 || v.indexOf('results') !== -1) {
        return r;
      }
    }
  }
  return null;
}

