function refreshDisplayTab() {
  // 1. Give the form engine time to safely commit the data row
  Utilities.sleep(2000);
  SpreadsheetApp.flush();
  
  // 2. Calculate the TARGET sheet name EXACTLY ONCE up front
  var ss = SpreadsheetApp.openById(RESPONSE_SPREADSHEET_ID);
  var displayName = formatDateForSheet(getNextSaturday(new Date()));
  
  // 3. Run your creation setup
  createDisplayTab();
  
  // 4. Run population
  var playerCount = populateDisplayTab();
  
  // 5. Target the explicit display tab directly without re-calculating the date string
  var display = ss.getSheetByName(displayName);
  
  // 6. Format only if the target sheet is verified and has players
  if (display && playerCount > 0) {
    formatDisplayRows(display, playerCount);
  }
}

function formatDisplayRows(sheet, startRow, numRows) {
  if (numRows <= 0) return;
  
  // 1. Format the Core Player Entry Area (Columns D through I | Column 4 to 9)
  var primaryDataRange = sheet.getRange(startRow, 4, numRows, 6);
  primaryDataRange.setBackground('#ffffff');
  primaryDataRange.setFontColor('#000000');
  primaryDataRange.setHorizontalAlignment('center');
  primaryDataRange.setBorder(true, true, true, true, true, true, '#cccccc', SpreadsheetApp.BorderStyle.SOLID);
  
  // 2. Format Column J (Column 10): Color #dad3bc + Thick Left/Right Borders
  var rangeJ = sheet.getRange(startRow, 10, numRows, 1);
  rangeJ.setBackground('#dad3bc');
  rangeJ.setHorizontalAlignment('center');
  // setBorder parameters: top, left, bottom, right, vertical, horizontal, color, style
  // Applies standard top/bottom/inner grid borders, but forces thick left and right walls
  rangeJ.setBorder(true, true, true, true, false, true, '#000000', SpreadsheetApp.BorderStyle.SOLID_MEDIUM);
  
  // 3. Format Column K (Column 11): Color #b3ab8d + Thick Left/Right Borders
  var rangeK = sheet.getRange(startRow, 11, numRows, 1);
  rangeK.setBackground('#b3ab8d');
  rangeK.setHorizontalAlignment('center');
  rangeK.setBorder(true, true, true, true, false, true, '#000000', SpreadsheetApp.BorderStyle.SOLID_MEDIUM);
  
  // 4. Format Column L (Column 12): Color #d9ead3 + Standard Grid Borders
  var rangeL = sheet.getRange(startRow, 12, numRows, 1);
  rangeL.setBackground('#d9ead3');
  rangeL.setHorizontalAlignment('center');
  rangeL.setBorder(true, true, true, true, true, true, '#cccccc', SpreadsheetApp.BorderStyle.SOLID);
}

/**
