  function formatDateForSheet(date) {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return `${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
  }

  function getNextSaturday(date) {
    var skipDays = (6 - date.getDay() + 7) % 7;
    var nextSat = new Date(date.getTime());
    nextSat.setDate(date.getDate() + skipDays);
    return nextSat;
  }

function createDisplayTab() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var templateSheet = ss.getSheetByName('Template');
  
  // 1. Resolve and clear or create your new output display sheet
  var displaySheet = ss.getSheetByName('Display');
  if (displaySheet) {
    displaySheet.clear();
  } else {
    displaySheet = ss.insertSheet('Display');
  }
  
  // 2. Load the template values to find where players end and the footer begins
  var lastRow = templateSheet.getLastRow();
  var templateValues = templateSheet.getRange(1, 1, lastRow, templateSheet.getLastColumn()).getValues();
  
  var playerRowsCount = 0;
  for (var i = 0; i < templateValues.length; i++) {
    // Row tracking for loops uses index 0. Row index 6 points directly to Column G.
    if (templateValues[i][6] === "League Results" || String(templateValues[i][6]).indexOf("HYPERLINK") !== -1) {
      break; // Found the updated hyperlink row anchor text in Column G!
    }
    // Assume valid player row if Column D (Index 3) has an initial signup number
    if (i >= 4 && templateValues[i][3] !== "") { 
      playerRowsCount++;
    }
  }
  
  // 3. Extract and map player entries (Row 5 down to the end of player data)
  var playerDataRange = templateSheet.getRange(5, 1, playerRowsCount, templateSheet.getLastColumn());
  var playerValues = playerDataRange.getValues();
  var cleanDisplayData = [];
  
  for (var p = 0; p < playerValues.length; p++) {
    var row = playerValues[p];
    var currentNum  = row[3]; // Column D (Index 3) - Remains unchanged
    var currentName = row[6]; // REMAP: Shifted from Index 4 (Column E) to Index 6 (Column G)
    
    // Build your display array template mapping structure
    cleanDisplayData.push([currentNum, "", "", currentName]);
  }
  
  // 4. Output the clean player data grid onto the Display tab
  if (cleanDisplayData.length > 0) {
    displaySheet.getRange(5, 4, cleanDisplayData.length, 4).setValues(cleanDisplayData);
    // Copy the original text block/borders from the player block rows
    templateSheet.getRange(5, 1, cleanDisplayData.length, templateSheet.getLastColumn())
                 .copyTo(displaySheet.getRange(5, 1), SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
  }
  
  // 5. REMAP: Copy the expanded 7-row footer (Rows 6-12) from the template 
  var footerTargetStartRow = 5 + cleanDisplayData.length;
  
  // Parameter 3 changed from 3 to 7 to safely hold rows 6, 7, 8, 9, 10, 11, and 12
  var footerSourceRange = templateSheet.getRange(6, 1, 7, templateSheet.getLastColumn());
  var footerTargetRange = displaySheet.getRange(footerTargetStartRow, 1, 7, templateSheet.getLastColumn());
  
  footerSourceRange.copyTo(footerTargetRange, SpreadsheetApp.CopyPasteType.PASTE_ALL, false);
  
  // 6. REMAP: Inject the exact League Results Hyperlink formula dynamically into Cell G8 of the new footer area
  // Row 8 on the footer block corresponds to (footerTargetStartRow + 2). Column G is 7.
  var hyperlinkCell = displaySheet.getRange(footerTargetStartRow + 2, 7);
  hyperlinkCell.setFormula('=HYPERLINK("https://ccttcratings.com", "League Results")');
}

function populateDisplayTab() {
  try {
    var ss = SpreadsheetApp.openById(RESPONSE_SPREADSHEET_ID);
    var displayName = formatDateForSheet(getNextSaturday(new Date()));
    var rawSheet = ss.getSheetByName('Raw ' + displayName);
    var display = ss.getSheetByName(displayName);

    if (!rawSheet) {
      throw new Error('Raw tab "Raw ' + displayName + '" not found.');
    }
    if (!display) {
      throw new Error('Display tab "' + displayName + '" not found - run createDisplayTab() first.');
    }

    var rawLastRow = rawSheet.getLastRow();
    if (rawLastRow < 2) {
      Logger.log('No responses in "Raw ' + displayName + '" yet.');
      return 0;
    }
    
    var rawLastCol = rawSheet.getLastColumn();
    var headers = rawSheet.getRange(1, 1, 1, rawLastCol).getValues()[0];
    var nameIdx = -1;
    var playingIdx = -1;
    var emailIdx = -1;
    
    for (var c = 0; c < headers.length; c++) {
      var h = String(headers[c] || '').toLowerCase().trim();
      if (h.indexOf('name') !== -1) { 
        nameIdx = c; 
      } else if (h.indexOf('playing') !== -1 || h.indexOf('status') !== -1 || h.indexOf('are you') !== -1) {
        playingIdx = c;
      } else if (h.indexOf('email') !== -1) {
        emailIdx = c;
      }
    }
    
    if (nameIdx === -1) { nameIdx = 1; }
    if (playingIdx === -1) { playingIdx = 3; }
    if (emailIdx === -1) { emailIdx = 2; }

    var dataRows = rawSheet.getRange(2, 1, rawLastRow - 1, rawLastCol).getValues();
    var players = [];
    var trackedEmails = {};
    var trackedNames = {};
    
    for (var r = dataRows.length - 1; r >= 0; r--) {
      var row = dataRows[r];
      var name = String(row[nameIdx] || '').trim();
      var nameKey = name.toLowerCase();
      var emailKey = String(row[emailIdx] || '').trim().toLowerCase();
      var playingStatus = String(row[playingIdx] || '').trim().toLowerCase();
      
      if (!name || name === '') continue;
      
      var alreadyTracked = false;
      if (emailKey && (emailKey in trackedEmails)) alreadyTracked = true;
      if (nameKey in trackedNames) alreadyTracked = true;
      
      if (!alreadyTracked) {
        if (emailKey) trackedEmails[emailKey] = playingStatus;
        trackedNames[nameKey] = playingStatus;
        
        if (playingStatus === 'yes') {
          var paddedName = "\u00A0\u00A0\u00A0" + name;
          players.unshift([paddedName]);
        }
      }
    }

    var organizedPlayers = [];
    for (var p = 0; p < players.length; p++) {
      var rowNumberStr = (p + 1) + ".";
      organizedPlayers.push([rowNumberStr, players[p]]);
    }

    if (organizedPlayers.length === 0) {
      var footerRowEmpty = findFooterRow(display, 6);
      if (footerRowEmpty && footerRowEmpty > 6) {
        display.getRange(6, 4, footerRowEmpty - 6, 2).clearContent();
        display.deleteRows(6, footerRowEmpty - 6);
      }
      Logger.log('No valid players to populate.');
      return 0;
    }

    var footerRow = findFooterRow(display, 6);
    if (!footerRow) {
      throw new Error('Footer row not found on display tab "' + displayName + '".');
    }

    if (footerRow > 6) {
      display.getRange(6, 4, footerRow - 6, 2).clearContent();
      display.deleteRows(6, footerRow - 6);
    }
    
    display.insertRows(6, organizedPlayers.length);
    display.getRange(6, 4, organizedPlayers.length, 2).clearContent();
    display.getRange(6, 4, organizedPlayers.length, 2).setValues(organizedPlayers);
    
    Logger.log('Populated "' + displayName + '" with ' + organizedPlayers.length + ' players.');
    return organizedPlayers.length;
  } catch (error) {
    sendErrorEmail('Error in populateDisplayTab: ' + error.toString() + '\n\nStack trace: ' + error.stack);
    return 0;
  }
}

function findFooterRow(sheet, fromRow) {
  var lastRow = sheet.getLastRow();
  if (lastRow < fromRow) return null;

  // FIX: Pull ALL remaining rows into memory with ONE single API request
  var numRowsToScan = lastRow - fromRow + 1;
  var allValues = sheet.getRange(fromRow, 1, numRowsToScan, sheet.getLastColumn()).getValues();

  for (var i = 0; i < allValues.length; i++) {
    var rowValues = allValues[i];
    
    // Scan across the cells of this row in memory
    for (var c = 0; c < rowValues.length; c++) {
      var v = String(rowValues[c] || '').toLowerCase();
      
      // Matches your newly configured hyperlink cell text natively
      if (v.indexOf('league results') !== -1 || v.indexOf('results') !== -1) {
        // Calculate the actual sheet row number (fromRow + current array loop position)
        return fromRow + i;
      }
    }
  }
  return null;
}

